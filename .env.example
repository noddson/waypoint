# Public browser configuration. Copy this file to .env.local for development.
# Never put an OAuth client secret or any other secret in a VITE_ variable.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-http-referrer-restricted-browser-key
VITE_GOOGLE_APP_ID=your-google-cloud-project-number
